<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # The shared-hosting document root is the repository root. Keep the
    # captured source/assets available, but send captured routes through
    # Laravel without exposing /public in the browser URL.
    RewriteRule ^$ public/index.php [END]

        # CMS media and theme assets are real files in the repository. Serve
        # them directly before the CMS page route is sent to Laravel.
        RewriteCond %{REQUEST_FILENAME} -f [OR]
        RewriteCond %{REQUEST_FILENAME} -d
        RewriteRule ^cms/(?:wp-content|wp-includes)/ - [END]

    RewriteRule ^(?:en|cms)(?:/|$) public/index.php [END]
    RewriteRule ^storage/(.*)$ public/storage/$1 [END]

    # Root-level static assets remain directly accessible.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # All other application routes use Laravel's front controller.
    RewriteRule ^ public/index.php [END]
</IfModule>
